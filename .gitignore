# Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Never ignore asset meta data
!/[Aa]ssets/**/*.meta

# IDE and solution files Unity regenerates
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity meta files for generated debug data
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Android signing: never commit a keystore
*.keystore
*.jks

# Meta XR Simulator and other local tool caches
/[Mm]eta[Xx][Rr][Ss]imulator/

# macOS
.DS_Store

# Unity build by-products
/.utmp/
/*_BurstDebugInformation_DoNotShip/
/*_BackUpThisFolder_ButDontShipItWithYourGame/

# Meta dev agent pairing settings (machine-specific address and token; the SDK regenerates it)
/Assets/Resources/DevAgentSettings.asset
/Assets/Resources/DevAgentSettings.asset.meta
